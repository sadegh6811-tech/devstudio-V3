# ═══════════════ الگوی متغیرهای محیطی DevStudio ═══════════════
# این فایل را به .env کپی کنید و مقادیر واقعی را در Vercel/سرور تنظیم نمایید.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# آدرس عمومی سایت (بدون اسلش انتهایی)
NEXT_PUBLIC_SITE_URL=https://devstudio.agency

# ════════════════ چت‌بات هوشمند (Render) ════════════════
CHATBOT_API_URL=https://devstudio-bot-keny.onrender.com

# ════════════════ درگاه پرداخت ════════════════
# زرین‌پال: شناسه پذیرنده را از panel.zarinpal.com بگیرید
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# کیف پول تتر روی شبکه TRC20
USDT_TRC20_ADDRESS=TXAshSffuAvj5ZmErtTSqymofoZMzP1sXn

# لینک‌های آماده پرداخت بین‌المللی (اختیاری)
STRIPE_PAYMENT_LINK=
PAYPAL_LINK=
PAYONEER_LINK=

# ════════════════ پوش نوتیفیکیشن (اختیاری) ════════════════
# تولید کلید: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_KEY=
